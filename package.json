{
  "name": "jewellery-erp",
  "version": "0.1.0",
  "description": "Focused ERP for jewellery stores",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "npm --workspace @jewellery-erp/web run dev",
    "dev:api": "npm --workspace @jewellery-erp/api run dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build": "turbo run build --concurrency=1",
    "lint": "turbo run lint --concurrency=1",
    "typecheck": "turbo run typecheck --concurrency=1",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "playwright test",
    "db:generate": "npm --workspace @jewellery-erp/db run db:generate",
    "db:migrate": "npm --workspace @jewellery-erp/db run db:migrate",
    "db:migrate:deploy": "npm --workspace @jewellery-erp/db run db:migrate:deploy",
    "db:migrate:status": "npm --workspace @jewellery-erp/db run db:migrate:status",
    "db:seed": "npm --workspace @jewellery-erp/db run db:seed",
    "db:check": "npm --workspace @jewellery-erp/db run db:check"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@sentry/node": "^10.52.0",
    "@supabase/supabase-js": "^2.105.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "playwright": "^1.59.1",
    "turbo": "^2.9.10",
    "vitest": "^4.1.5"
  }
}
