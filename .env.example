# Supabase Postgres — copy URI from Dashboard → Project Settings → Database → Connection string (URI)
# Use the *direct* host (db.<project-ref>.supabase.co:5432), not Docker localhost.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_DSN=
